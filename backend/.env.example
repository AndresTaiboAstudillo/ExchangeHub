# Conexión a PostgreSQL (en local usa localhost; dentro de Docker Compose
# se define en docker-compose.yml con el host "postgres").
DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/NOMBRE_DB"

PORT=8000

# Secreto para firmar los JWT: mínimo 32 caracteres.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600

# Origen permitido por CORS (URL del frontend)
FRONTEND_ORIGIN=http://localhost:3000

# Servicio Python (nombre del servicio en Docker Compose)
PYTHON_SERVICE_URL=http://localhost:8001
PYTHON_SERVICE_TIMEOUT_MS=3000

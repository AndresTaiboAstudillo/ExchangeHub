# Copia este archivo como terraform.tfvars (git lo ignora) y completa los valores.

# Windows con Docker Desktop. En Linux o macOS déjalo comentado.
docker_host = "npipe:////./pipe/docker_engine"

# Reemplaza los dos valores. Mientras digan "REEMPLAZAR", terraform plan falla a propósito
# (la contraseña exige 12 caracteres y el secreto 32). Genera el secreto con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
postgres_password = "REEMPLAZAR"
jwt_secret        = "REEMPLAZAR"

# Opcional. Se incluye en el User-Agent de las descargas a Mineduc y Wikidata (buena práctica).
# pipeline_contact = "tu-correo@ejemplo.cl"

# Opcional. 168 = revisar las fuentes una vez por semana. 0 (por defecto) = solo manual.
# ingestion_interval_hours = 168

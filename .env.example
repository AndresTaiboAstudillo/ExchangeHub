# Copia este archivo como .env (no se sube a git) y completa los valores.

# PostgreSQL (los usa el contenedor de Postgres y el backend)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Backend
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600
FRONTEND_ORIGIN=http://localhost:3000

# Frontend (se incorpora en el build)
NEXT_PUBLIC_API_URL=http://localhost:8000

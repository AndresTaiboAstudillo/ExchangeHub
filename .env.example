# Copia este archivo como .env (no se sube a git) y completa los valores.

# PostgreSQL (los usa el contenedor de Postgres y el backend)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Backend
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600
FRONTEND_ORIGIN=http://localhost:3000

# Frontend (se incorpora en el build)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Mosaicos del mapa de Inicio. Por defecto, OpenStreetMap (uso moderado, con atribución).
# NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Pipeline de datos de universidades (opcionales)
# Contacto que se incluye en el User-Agent de las descargas (correo o URL del proyecto).
PIPELINE_CONTACT=
# Horas entre revisiones automáticas de las fuentes. 0 = solo manual (168 = semanal).
INGESTION_INTERVAL_HOURS=0
# Ruta (dentro del contenedor de Python) de un Excel del catálogo descargado a mano. Solo se usa si
# la descarga automática no está permitida por robots.txt o falla. Ver docker-compose.yml.
# MINEDUC_CATALOG_FILE=
# API Overpass de OpenStreetMap, de donde salen los comercios del mapa (servicio Python).
# Varios servidores separados por coma: se prueban en orden si el primero falla.
# OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
# Nivel mínimo de los registros JSON de backend y servicio Python: debug, info, warn o error.
LOG_LEVEL=info
# Orígenes que pueden llamar a la API (CORS), separados por comas. Para la app Android de Capacitor
# agrega https://localhost, p. ej.: FRONTEND_ORIGIN=http://localhost:3000,https://localhost

# Recuperación de contraseña por correo
# Por defecto los correos van a Mailpit (docker compose): ábrelo en http://localhost:8025.
# Para producción, completa los datos de tu proveedor SMTP (y deja SMTP_HOST con su dirección).
# SMTP_HOST=smtp.tu-proveedor.cl
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=ExchangeHub <no-reply@tu-dominio.cl>
# Dirección pública del frontend para el enlace del correo (por defecto, el primer FRONTEND_ORIGIN).
# FRONTEND_URL=https://exchangehub.tu-dominio.cl
# Detrás de un proxy inverso: número de saltos de confianza (1). Sin esto el límite de intentos
# de inicio de sesión vería a todos con la IP del proxy.
# TRUST_PROXY=2   (con el proxy de docker-compose + ngrok son dos saltos; con un solo proxy, 1)

# Copia este archivo como .env (no se sube a git) y completa los valores.

# PostgreSQL (los usa el contenedor de Postgres y el backend)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Backend
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600
FRONTEND_ORIGIN=http://localhost:3000

# Frontend (se incorpora en el build)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Pipeline de datos de universidades (opcionales)
# Contacto que se incluye en el User-Agent de las descargas (correo o URL del proyecto).
PIPELINE_CONTACT=
# Horas entre revisiones automáticas de las fuentes. 0 = solo manual (168 = semanal).
INGESTION_INTERVAL_HOURS=0
# Ruta (dentro del contenedor de Python) de un Excel del catálogo descargado a mano. Solo se usa si
# la descarga automática no está permitida por robots.txt o falla. Ver docker-compose.yml.
# MINEDUC_CATALOG_FILE=

  "paths": {
    "/": {
      "get": {
        "operationId": "root__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Mensaje de bienvenida del servicio",
        "tags": [
          "salud"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "El proceso está vivo",
        "tags": [
          "salud"
        ]
      }
    },
    "/v1/pipeline/universities/run": {
      "post": {
        "description": "Descarga el catálogo oficial del Mineduc y, opcionalmente, enriquece las universidades con datos estructurados de Wikidata. Valida, normaliza, deduplica y cruza los registros, y devuelve además la procedencia de cada dato y un informe de calidad.\n\nLas URL de las fuentes provienen de la configuración del servicio, nunca de la petición. Si el catálogo no está disponible, `status` es `failed`; si solo falla Wikidata, es `partial` y se devuelve igualmente el catálogo.",
        "operationId": "run_universities_v1_pipeline_universities_run_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PipelineResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Recupera, limpia y cruza los datos de universidades de Chile",
        "tags": [
          "pipeline"
        ]
      }
    }
  }

{
  "components": {
    "schemas": {
      "CreateFriendshipDto": {
        "properties": {
          "addresseeId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "addresseeId"
        ],
        "type": "object"
      },
      "CreatePostDto": {
        "properties": {
          "body": {
            "maxLength": 10000,
            "type": "string"
          },
          "category": {
            "maxLength": 50,
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "type": "string"
          }
        },
        "required": [
          "category",
          "title",
          "body"
        ],
        "type": "object"
      },
      "CreateReplyDto": {
        "properties": {
          "body": {
            "maxLength": 5000,
            "type": "string"
          }
        },
        "required": [
          "body"
        ],
        "type": "object"
      },
      "LoginDto": {
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 254,
            "type": "string"
          },
          "password": {
            "maxLength": 72,
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "RegisterDto": {
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 254,
            "type": "string"
          },
          "name": {
            "maxLength": 100,
            "type": "string"
          },
          "password": {
            "maxLength": 72,
            "minLength": 8,
            "type": "string"
          },
          "universityOrigin": {
            "maxLength": 150,
            "type": "string"
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ],
        "type": "object"
      },
      "RespondFriendshipDto": {
        "properties": {
          "status": {
            "enum": [
              "accepted",
              "rejected"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "UpdateProfileDto": {
        "properties": {
          "bio": {
            "maxLength": 1000,
            "nullable": true,
            "type": "string"
          },
          "career": {
            "maxLength": 100,
            "nullable": true,
            "type": "string"
          },
          "countryOfOrigin": {
            "maxLength": 100,
            "nullable": true,
            "type": "string"
          },
          "hobbies": {
            "description": "Reemplaza la lista completa.",
            "items": {
              "maxLength": 50,
              "type": "string"
            },
            "maxItems": 20,
            "type": "array"
          },
          "isVisible": {
            "type": "boolean"
          },
          "languageCodes": {
            "description": "Reemplaza la lista completa. Códigos como \"es\", \"en\" o \"pt-br\".",
            "items": {
              "pattern": "^[a-z]{2,3}(-[a-z0-9]{2,8})?$",
              "type": "string"
            },
            "maxItems": 10,
            "type": "array"
          },
          "name": {
            "maxLength": 100,
            "type": "string"
          },
          "universityOrigin": {
            "maxLength": 150,
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "API de ExchangeHub, la plataforma para estudiantes internacionales en Chile. El frontend solo habla con esta API; NestJS es el único que llama al servicio Python y a la base de datos. Las rutas protegidas exigen `Authorization: Bearer <token>` (token de `POST /auth/login`). Cada respuesta incluye `X-Request-Id`, que también se puede enviar para seguir una petición en los registros.",
    "title": "ExchangeHub API",
    "version": "1.0"
  },
  "openapi": "3.0.0",

                "$ref": "#/components/schemas/LoginDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Iniciar sesión y obtener un token JWT",
        "tags": [
          "Autenticación"
        ]

    "/universities": {
      "get": {
        "operationId": "UniversitiesController_list",
        "parameters": [
          {
            "in": "query",
            "name": "category",
            "required": false,
            "schema": {
              "enum": [
                "universidad",
                "instituto_profesional",
                "centro_formacion_tecnica"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "ownership",
            "required": false,
            "schema": {
              "enum": [
                "estatal",
                "particular_con_aportes",
                "privada",
                "otra"
              ],
              "type": "string"
            }
          },
          {
            "description": "Por defecto solo se listan instituciones vigentes.",
            "in": "query",
            "name": "includeInactive",
            "required": false,
            "schema": {
              "default": false,
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "type": "number"
            }
          },
          {
            "description": "Texto de búsqueda. Con texto, los resultados se ordenan por relevancia (BM25).",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "maxLength": 100,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Buscar instituciones (búsqueda BM25 con filtros) o listarlas",
        "tags": [
          "Universidades"
        ]
      }
    },
